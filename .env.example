# ==============================================================================
# MessMind Environment Variables
# Copy this file to .env.local or .env for development.
# In production (AWS Amplify / AWS RDS), configure these in AWS Amplify Console or Secrets Manager.
# ==============================================================================

# Database Connection (PostgreSQL / Amazon RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/messmind?schema=public"

# Gemini API Key (Server-side natural language explanation layer only)
GEMINI_API_KEY=""

# Authentication & Security
AUTH_SECRET="your-development-auth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
PREDICTION_DEFAULT_BUFFER_PERCENT="5"
DEMO_ENVIRONMENT="true"
