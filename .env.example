# ==============================================================================
# MessMind Environment Variables
# Copy this file to .env.local or .env for development.
# ==============================================================================

# ==============================================================================
# 1. Static Demo Mode (Public / Zero-Database)
# ==============================================================================
# NEXT_PUBLIC_DEMO_MODE:
# - Set to "true" to run MessMind in client-side static demo mode.
# - Operates with synthetic benchmark data (125 residents, 205 meals) and in-browser simulation.
# - Requires NO PostgreSQL database, NO Docker containers, and NO AWS Bedrock credentials.
# - This is a PUBLIC environment variable prefixed with NEXT_PUBLIC_ and is bundled to the client.
# - Note: You can also use `npm run dev:demo` or `npm run build:static` without creating a .env file.
NEXT_PUBLIC_DEMO_MODE="true"

# ==============================================================================
# 2. Full-Stack Production Mode (Server-Only Secrets & Database)
# ==============================================================================
# When NEXT_PUBLIC_DEMO_MODE is false or unset, MessMind runs in full-stack mode
# requiring PostgreSQL, Prisma, and server-side runtime APIs.
# The variables below are SERVER-ONLY and must never be exposed to the browser.

# Database Connection (PostgreSQL / Amazon RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/messmind?schema=public"

# ==============================================================================
# Amazon Bedrock Explanation Layer (Server-Side Only)
# ==============================================================================
# AWS Credentials:
# MessMind uses the AWS SDK's standard credential provider chain:
# - In local development: use your local AWS credentials via AWS CLI / SSO / profile (~/.aws/credentials).
# - In production (AWS Amplify / App Runner / ECS): use an IAM execution role with bedrock:InvokeModel.
# DO NOT commit or hardcode long-lived AWS access keys into .env files.
#
# Bedrock Configuration:
# - BEDROCK_REGION: The AWS region where your Bedrock model is enabled (e.g. us-east-1, us-west-2).
# - BEDROCK_MODEL_ID: Model ID enabled in your AWS account (e.g. amazon.nova-micro-v1:0, anthropic.claude-3-haiku-20240307-v1:0, amazon.titan-text-express-v1).
# If BEDROCK_MODEL_ID is empty or Bedrock is unreachable, MessMind seamlessly uses its deterministic explanation fallback.
BEDROCK_REGION="us-east-1"
BEDROCK_MODEL_ID=""

# Authentication & Security (Server-Side Only)
AUTH_SECRET="your-development-auth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
PREDICTION_DEFAULT_BUFFER_PERCENT="5"
DEMO_ENVIRONMENT="true"
